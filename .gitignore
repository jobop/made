# 本机配置（可能含令牌，不入库；模板见 config.example.json）
config.local.json

# 运行时状态：任务记录、会话、语音设置等
state/

# 动态工作目录：每个任务会话的代码工作区
workspaces/

# 演示项目（本地生成，非源码）
demo-project/

# 依赖与系统文件
node_modules/
.DS_Store
*.log

# ESP-IDF 构建产物，不入库
made/build*/
receiver/build*/

# WorkBuddy 工作区数据（会话记忆等）
.workbuddy/

# 用户包目录已移出仓库：插件与主题装在 ~/made/{plugins,themes}（可用 MADE_HOME 覆盖），
# 桥接器启动时自动扫描。随代码发布的内置包在 bridge/builtin/，需要入库。
