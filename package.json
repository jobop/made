{
  "name": "made",
  "version": "0.1.0",
  "private": true,
  "description": "码得仓库：设备、接收器、桥接器，以及与运行时解耦的包管理",
  "scripts": {
    "start": "npm --prefix bridge start",
    "doctor": "npm --prefix bridge run doctor",
    "test": "npm --prefix bridge test",
    "flash": "node tools/flash.mjs",
    "shot": "node tools/shot.mjs",
    "sim": "make -C sim",
    "sim:shot": "make -C sim shot",
    "sim:rect": "make -C sim SCREEN=240x320",
    "sim:rect:shot": "make -C sim SCREEN=240x320 shot"
  },
  "engines": {
    "node": ">=22"
  }
}